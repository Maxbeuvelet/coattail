# ─────────────────────────────────────────────────────────────
#  Polymarket Copy-Trade Bot — backend config
#  Copy this file to `.env` and fill it in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Safety gate ──────────────────────────────────────────────
# Master switch. "false" = paper trading (simulated, no real orders).
# Flip to "true" ONLY after paper mode has proven the strategy.
LIVE_TRADING=false

# ── Public sharing ───────────────────────────────────────────
# If set, the dashboard is READ-ONLY for the public. Only requests carrying
# this key (the owner) can change settings, follow/unfollow, pause, or reset.
# Set this before exposing the app publicly (e.g. via Tailscale Funnel).
# Unlock a device by visiting:  <your-url>/?key=THIS_VALUE
OWNER_KEY=

# ── Polymarket US API (needed when LIVE_TRADING=true) ────────
# Live execution goes to Polymarket US — the venue a US trader can actually
# use, and the one the US shadow book measures. Create a key at
# polymarket.us/developer (identity verification in the app comes first).
# The secret is shown ONCE. Both stay on the backend; neither reaches the browser.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Hard ceiling on a single live order, in dollars. Enforced inside the executor,
# so a sizing bug upstream still cannot spend more than this.
LIVE_MAX_USD_PER_ORDER=2

# Slippage tolerance on live orders, in basis points.
LIVE_SLIPPAGE_BIPS=200

# true  → orders are validated against the venue but NOT sent (safe rehearsal)
# false → real orders, real money
# Leave true until you have watched a deploy preview orders correctly.
LIVE_DRY_RUN=true

# ── Your wallet (international CLOB only — unused by Polymarket US) ──
# Private key of the Polygon wallet funded with USDC.
# This stays on the backend only. It is NEVER sent to the browser.
POLYGON_PRIVATE_KEY=

# Polymarket CLOB API credentials (derived from your key on first run,
# or created via the client). Leave blank to auto-derive.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# ── Endpoints ────────────────────────────────────────────────
CLOB_HOST=https://clob.polymarket.com
DATA_API=https://data-api.polymarket.com
CHAIN_ID=137

# ── Risk defaults (also editable from the dashboard) ─────────
BANKROLL_USD=1000
MAX_USD_PER_POSITION=5
MAX_OPEN_POSITIONS=20
DAILY_LOSS_KILL_PCT=0.10
PRICE_BAND_LOW=0.05
PRICE_BAND_HIGH=0.95

# ── Server ───────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# Comma-separated origins allowed to call the API (the React dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
