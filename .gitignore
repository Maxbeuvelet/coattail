# ── Secrets — NEVER commit ──────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
wallet.json

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ── Node / frontend ─────────────────────────────────────
node_modules/
dist/
.vite/
*.local

